{
  "MaxUploadBytes": 10485760,
  "RateLimiting": {
    "Upload": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "Tally": "Server=localhost;Database=TallyIngestion;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
